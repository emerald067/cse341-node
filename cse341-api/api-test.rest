### Get all contacts
GET http://localhost:8080/contacts


### Get one contact
GET http://localhost:8080/contacts/contact?id=6a9f63b08ad97ce4755ceab2


### Create contact
POST http://localhost:8080/contacts
Content-Type: application/json

{
  "firstName": "Mary",
  "lastName": "Johnson",
  "email": "mary@example.com",
  "favoriteColor": "Purple",
  "birthday": "2000-08-15"
}


### Update contact
PUT http://localhost:8080/contacts/6ab7bde9dd1019d6e9dbfeda
Content-Type: application/json

{
  "firstName": "Mary",
  "lastName": "Johnson",
  "email": "mary.updated@example.com",
  "favoriteColor": "Blue",
  "birthday": "2000-08-15"
}


### Delete contact
DELETE http://localhost:8080/contacts/6ab7bde9dd1019d6e9dbfeda


### Test Mongoose validation
POST http://localhost:8080/contacts
Content-Type: application/json

{
  "firstName": "Validation",
  "lastName": "Test",
  "email": "validation@example.com",
  "favoriteColor": "Blue"
}

### Get nonexistent contact
GET http://localhost:8080/contacts/contact?id=000000000000000000000000


### Update nonexistent contact
PUT http://localhost:8080/contacts/000000000000000000000000
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "Contact",
  "email": "test@example.com",
  "favoriteColor": "Blue",
  "birthday": "2000-01-01"
}


### Delete nonexistent contact
DELETE http://localhost:8080/contacts/000000000000000000000000


